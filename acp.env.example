# Shell 模板：复制到仓库外，修改后用 . /绝对路径/acp.env 加载。
# 变量须进入实际 ACP agent 进程；NUWAX_PATH 指向 CLI，不能带子命令。
# 每个 NUWAX_* 变量都有同义 CODEX_* 别名(如 CODEX_BASE_URL)：双设异值启动报错。
# 先从受保护环境提供 NUWAX_API_KEY；本文件没有可用凭据。
export NUWAX_API_KEY="${NUWAX_API_KEY:?请先安全注入 NUWAX_API_KEY}"
export NUWAX_PATH='/absolute/path/to/nuwax-harness'
export NUWAX_BASE_URL='https://your-provider.example/v1'
export NUWAX_API_PROTOCOL='openai'
export NUWAX_WIRE_API='chat'
export NUWAX_BRIDGE='rig'
export NUWAX_MODEL='your-model-id'
# 不设置 NUWAX_HOME 时默认 ~/.nuwax-harness；需要独立实例时使用已有绝对路径。
# export NUWAX_HOME='/absolute/path/to/nuwax-harness-state'
export INITIAL_AGENT_MODE='workspace-write'

# 核对真实窗口后取消注释；不要照抄为所有模型的规格。
# export NUWAX_MODEL_CONTEXT_WINDOW='128000'
# 可选日志目录，留意日志中的工作内容也属于敏感数据。
# export NUWAX_LOG_DIR='/absolute/path/to/agent-logs'

# 引擎侧开关(适配器原样透传给 app-server；写进 config.toml 同样效果)：
# 网关不认识 tool_search 线格式 / 需要确定性工具表：
# export NUWAX_TOOL_SEARCH='false'
# 宿主把整屏截图塞进上下文、网关 413：整请求图片预算(默认 20 MiB)、单图预算。
# export NUWAX_REQUEST_IMAGE_MAX_BYTES='20971520'
# export NUWAX_IMAGE_MAX_BYTES='2097152'
# OpenAI 第一方出站总闸，默认关闭；只有 =1 才打开。
# export NUWAX_OPENAI_EGRESS='1'

# Anthropic：同时换成相应基址、Key、模型。
# export NUWAX_API_PROTOCOL='anthropic'
# unset NUWAX_WIRE_API
# export NUWAX_BRIDGE='rig'

# 原生 Responses：同时换成相应基址、Key、模型。
# export NUWAX_API_PROTOCOL='openai'
# export NUWAX_WIRE_API='responses'
# export NUWAX_BRIDGE='native'
# 环境网关无需显式 authenticate；显式 auth / providers/set 会替换或清除它。
