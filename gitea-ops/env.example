# 复制为 .env 后填入真实值；本文件本身不入库真实口令。
# 用法： set -a; . ./gitea-ops/.env; set +a

# ---- Gitea 服务端 ----
# 用主机 IP，不要用容器服务名（job 容器的网络里解析不到）
GITEA_URL=http://<gitea-host-ip>:3301
GITEA_USER=<admin-user>
GITEA_PASS=<admin-password>
GITEA_REPO=<owner>/<repo>
GITEA_REMOTE=gitea
# 注册 runner 用的一次性 token（Gitea UI 或 `gitea actions generate-runner-token`）
GITEA_RUNNER_TOKEN=<runner-registration-token>

# ---- 构建机 ----
# 该机 ci 数据根：toolchain / artifacts
CI_DATA_ROOT=/data/nvme1/gitea-ci
# 该机缓存根：cargo target / vendor / rusty_v8 / act
CI_CACHE_ROOT=/data/nvme0/ci-cache
# 可选覆盖，默认由上面两个推导
# CI_CARGO_HOME=$CI_DATA_ROOT/toolchain/cargo
# CI_RUSTUP_HOME=$CI_DATA_ROOT/toolchain/rustup
# CI_ZIG_DIR=$CI_DATA_ROOT/toolchain/zig

# 覆盖工作流里按内存自适应的 cargo 并行度（一般不用设）
# CI_CARGO_JOBS=2

# ---- 可选：离线种子（新机器无外网时用本地文件） ----
# VENDOR_TARBALL=/path/to/ci-vendor.tar.gz
# RUSTY_V8_SEED=/path/to/v8seed            # 目录，内含 <target>/*.a.gz
# MUSL_CROSS_TARBALL=/path/to/aarch64-linux-musl-cross.tgz
