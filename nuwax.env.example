# Shell 模板：复制到仓库外，修改后用 . /绝对路径/agent.env 加载。
# 先从受保护环境提供 NUWAX_API_KEY；本文件没有可用凭据。
export NUWAX_API_KEY="${NUWAX_API_KEY:?请先安全注入 NUWAX_API_KEY}"
export NUWAX_BASE_URL='https://your-provider.example/v1'
export NUWAX_WIRE_API='chat'
export NUWAX_MODEL='your-model-id'
export NUWAX_BRIDGE='rig'

# 不设置 NUWAX_HOME(同义别名 CODEX_HOME,二选一,双设异值报错)时默认 ~/.nuwax-harness。
# 每个独立服务实例可覆盖为自己的可写目录或外接盘绝对路径。
# export NUWAX_HOME='/absolute/path/to/nuwax-harness-state'

# 预算示例：核对模型实际能力再取消注释，不是所有模型的默认规格。
# export NUWAX_MODEL_CONTEXT_WINDOW='128000'
# export NUWAX_MAX_OUTPUT_TOKENS='4096'
# export NUWAX_AUTO_COMPACT_RATIO='0.8'
# export NUWAX_REQUEST_MAX_RETRIES='1'
# export NUWAX_STREAM_MAX_RETRIES='1'
# export NUWAX_STREAM_IDLE_TIMEOUT_MS='120000'

# 声明该网关的模型真实接受的 reasoning effort 档位(逗号分隔，rig 的词表：
# minimal/low/medium/high/xhigh/max)。声明后，选了模型没有的档位会在
# 发出前就报错并点名该变量与可用档位，而不是被网关静默映射成别的档位。
# GLM-5.3 / GLM-5.3-FLASH / GLM-5.3-FLASHX 官方文档只支持 low/high/max：
# export NUWAX_REASONING_EFFORT_LEVELS='low,high,max'
# 不设置时保持宽松(沿用 rig 对未收录模型的默认)，不校验档位。
# 不能用 none/off 表示"关闭思考"：这些网关始终思考，关闭思考会被拒绝。
# 必须能附着到一个 provider：随本文件的完整启动组使用，或配合
# `-c model_provider=<id>`；两者都没有会在启动时报错(见 NUWAX-HARNESS.md §4)。
# Chat 与 Anthropic 两条 rig 线都受这道门约束。

# Anthropic：同时换成相应基址、Key、模型。
# export NUWAX_WIRE_API='anthropic'
# export NUWAX_BRIDGE='rig'

# 原生 Responses：同时换成相应基址、Key、模型。
# export NUWAX_WIRE_API='responses'
# export NUWAX_BRIDGE='native'
# 切回 Chat / Anthropic 时，把 bridge 也改回 rig。
