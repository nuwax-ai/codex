# Copy to scripts/gitea-ci/.env (gitignored) and adjust.
# Everything here is read by scripts/gitea-ci/ci.sh.

# Gitea instance
GITEA_URL=http://192.168.31.23:3301
GITEA_USER=ci
# Prefer a token; leave GITEA_PASS empty when using one.
GITEA_TOKEN=
GITEA_PASS=ci-local-test-only

# The Gitea copy of this repository (owner/name) and the git remote that
# points at it. `make gitea-smoke` pushes HEAD there, `make gitea-release`
# pushes a tag.
GITEA_REPO=ci/ci-smoke
GITEA_REMOTE=gitea
GITEA_BRANCH=main

# Where the stack runs (for logs, artifacts, inventory, up/down).
GITEA_SSH=swufe@192.168.31.23
CI_DATA_ROOT=/data/nvme1/gitea-ci
