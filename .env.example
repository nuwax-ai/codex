# Copy this file to `.env.local` (gitignored) and fill in real credentials
# for the live tests (codex-rs/live-tests crate).
#
# Multi-vendor matrix: list vendors, then define LIVE_<NAME>_* per vendor.
# Keep the vendor list in sync with the matrix! macros in
# codex-rs/live-tests/tests/*.rs. Artifacts land under logs/live-<vendor>/.
LIVE_VENDORS=mimo,glm

LIVE_MIMO_API_KEY=
LIVE_MIMO_CHAT_URL=https://token-plan-cn.xiaomimimo.com/v1
# Optional: only when the vendor exposes an Anthropic-protocol gateway.
LIVE_MIMO_ANTHROPIC_URL=https://token-plan-cn.xiaomimimo.com/anthropic/v1
LIVE_MIMO_MODEL=mimo-v2.6-flash

LIVE_GLM_API_KEY=
LIVE_GLM_CHAT_URL=https://open.bigmodel.cn/api/coding/paas/v4
LIVE_GLM_ANTHROPIC_URL=https://open.bigmodel.cn/api/anthropic/v1
# Optional: only when the Responses endpoint differs from the chat URL
# (GLM serves responses at /api/v1; used by the native-transport suite only).
LIVE_GLM_RESPONSES_URL=https://open.bigmodel.cn/api/v1
LIVE_GLM_MODEL=GLM-5.3-Flash
