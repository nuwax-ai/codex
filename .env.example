# Copy this file to `.env.local` (gitignored) and fill in real credentials
# for the live tests (codex-rust-genai-bridge/tests/ and codex-rs/exec/tests/).
MIMO_API_KEY=
# OpenAI-compatible Chat Completions / Responses endpoint
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# Anthropic Messages protocol endpoint (routed to genai's Anthropic adapter)
MIMO_ANTHROPIC_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic/v1
MIMO_MODEL=mimo-v2.6-flash
