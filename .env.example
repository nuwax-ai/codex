# Copy this file to `.env.local` (gitignored) and fill in real credentials
# for the live tests (codex-rs/live-tests crate). Switching vendors is pure
# configuration: point the URLs/model at another provider and artifacts move
# to logs/live-<vendor>/ automatically.
LIVE_VENDOR_NAME=mimo
LIVE_VENDOR_API_KEY=
LIVE_VENDOR_CHAT_URL=https://token-plan-cn.xiaomimimo.com/v1
# Optional: only when the vendor also exposes an Anthropic-protocol gateway.
LIVE_VENDOR_ANTHROPIC_URL=https://token-plan-cn.xiaomimimo.com/anthropic/v1
LIVE_VENDOR_MODEL=mimo-v2.6-flash
