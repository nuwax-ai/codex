# Copy this file to `.env.local` (gitignored) and fill in real credentials
# for the live tests (codex-rs/live-tests crate).
#
# Multi-vendor matrix: list vendors, then define LIVE_<NAME>_* per vendor.
# Keep the vendor list in sync with the matrix! macros in
# codex-rs/live-tests/tests/*.rs. Artifacts land under logs/live-<vendor>/.
LIVE_VENDORS=mimo,glm,step

LIVE_MIMO_API_KEY=
LIVE_MIMO_CHAT_URL=https://token-plan-cn.xiaomimimo.com/v1
LIVE_MIMO_ANTHROPIC_URL=https://token-plan-cn.xiaomimimo.com/anthropic
# Responses must be explicit even when it shares the chat base URL.
LIVE_MIMO_RESPONSES_URL=https://token-plan-cn.xiaomimimo.com/v1
# Also verified: mimo-v2.5
LIVE_MIMO_MODEL=mimo-v2.6-flash

LIVE_GLM_API_KEY=
LIVE_GLM_CHAT_URL=https://open.bigmodel.cn/api/coding/paas/v4
LIVE_GLM_ANTHROPIC_URL=https://open.bigmodel.cn/api/anthropic
# Responses uses its own endpoint with both the Rig and native routes.
LIVE_GLM_RESPONSES_URL=https://open.bigmodel.cn/api/v1
LIVE_GLM_MODEL=GLM-5.3-Flash

LIVE_STEP_API_KEY=
LIVE_STEP_CHAT_URL=https://api.stepfun.com/step_plan/v1
LIVE_STEP_ANTHROPIC_URL=https://api.stepfun.com/step_plan
# No Step Responses endpoint declared.
# Also verified: step-3.7-flash
LIVE_STEP_MODEL=step-5-preview
