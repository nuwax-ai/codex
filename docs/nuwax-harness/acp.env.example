# Shell 模板：复制到仓库外，修改后用 . /绝对路径/acp.env 加载。
# 变量须进入实际 ACP agent 进程；CODEX_PATH 指向 CLI，不能带子命令。
# 每个 CODEX_* 变量都有同义 NUWAX_* 别名(如 NUWAX_BASE_URL)：双设异值启动报错。
# 先从受保护环境提供 CODEX_API_KEY；本文件没有可用凭据。
export CODEX_API_KEY="${CODEX_API_KEY:?请先安全注入 CODEX_API_KEY}"
export CODEX_PATH='/absolute/path/to/nuwax-harness'
export CODEX_BASE_URL='https://your-provider.example/v1'
export CODEX_API_PROTOCOL='openai'
export CODEX_WIRE_API='chat'
export CODEX_BRIDGE='rig'
export CODEX_MODEL='your-model-id'
# 不设置 CODEX_HOME 时默认 ~/.nuwax-harness；需要独立实例时使用已有绝对路径。
# export CODEX_HOME='/absolute/path/to/nuwax-harness-state'
export INITIAL_AGENT_MODE='workspace-write'

# 核对真实窗口后取消注释；不要照抄为所有模型的规格。
# export CODEX_MODEL_CONTEXT_WINDOW='128000'
# 可选日志目录，留意日志中的工作内容也属于敏感数据。
# export CODEX_LOG_DIR='/absolute/path/to/agent-logs'

# Anthropic：同时换成相应基址、Key、模型。
# export CODEX_API_PROTOCOL='anthropic'
# unset CODEX_WIRE_API
# export CODEX_BRIDGE='rig'

# 原生 Responses：同时换成相应基址、Key、模型。
# export CODEX_API_PROTOCOL='openai'
# export CODEX_WIRE_API='responses'
# export CODEX_BRIDGE='native'
# 环境网关无需显式 authenticate；显式 auth / providers/set 会替换或清除它。
